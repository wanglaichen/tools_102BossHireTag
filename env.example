# ========== 基础服务（Flask API）==========
# APP_PORT = API 端口，不是前端端口
APP_HOST=0.0.0.0
APP_PORT=9212
# APP_VERSION=v1.2.1

# ========== Web 模式 ==========
# new = Next 前端 + API（推荐）
# api = 只起 API，不起 Web
# 管理脚本: ./start.sh  ./stop.sh  ./build.sh
WEB_MODE=new

# ========== Web 前端（Next.js · client/，仅 WEB_MODE=new）==========
# CLIENT_PORT = 前端管理界面端口（不要和 APP_PORT 搞混）
CLIENT_HOST=127.0.0.1
CLIENT_PORT=3000
# 浏览器里请求 API 的完整地址（本地一般指向 APP_PORT）
# 改了之后需要重新 ./build.sh 才会打进前端包
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9212

# ========== Redis 存储 ==========
# Key 统一用冒号分隔，例如 jjob:tools102-boss-hire-tag:state
# 忽略企业写入 …:ignored:items（启动时会从旧 …:blacklist:* 自动迁移）
# 小程序会话为 …:auth:session:{token}（独立 TTL）
STORAGE_BACKEND=redis
REDIS_URL=redis://default:your_password@your-redis-host:6379/0
REDIS_KEY_PREFIX=jjob:tools102-boss-hire-tag:state
REDIS_PROXY_KEY=jjob:tools102-boss-hire-tag:proxy
REDIS_SETTINGS_KEY=jjob:tools102-boss-hire-tag:settings
REDIS_CHANNELS_KEY=jjob:tools102-boss-hire-tag:channels
# 远程 Redis 建议 15~30；过短容易在整包读取时超时并提示“读取数据库失败”
REDIS_TIMEOUT_SECONDS=15

# ========== 进程代理（可选） ==========
# APP_PROXY_URL=http://127.0.0.1:7890

# ========== 微信小程序（服务端） ==========
# 获取位置：https://mp.weixin.qq.com/ → 开发管理 → 开发设置
#
# WECHAT_APPID：
#   - 小程序 AppID（小程序 ID）
#   - 给小程序工程用（也可填进 miniprogram/project.config.json）
#   - 可随文档公开，不算最高机密，但仍建议按项目保管
#
# WECHAT_SECRET：
#   - 小程序 AppSecret（密钥）
#   - 只放服务器 .env，不要写进小程序前端代码
#   - 不要提交到 Git（.env 已在 .gitignore）
#   - 泄露后请立刻在公众平台重置
#
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret

# 是否强制 API 鉴权（提审/生产建议设为 1；本地先联调可先 0）
MINIAPP_AUTH_REQUIRED=0

# 开发联调临时 Token（生产请留空或删除）
# 开启后可用该 Token 调 API；登录也可用 code=dev（需已配置本项）
# MINIAPP_DEV_TOKEN=dev-local-token

# 登录 Token 有效期（秒）。默认 365 天，最短 1 天；有业务请求时滑动续期，不做前端定时探活。
AUTH_SESSION_TTL_SECONDS=31536000

# 自助注册试用时长（小时）。默认 72（3 天）；到期后需管理员「解除试用」或解锁。
# 管理员在后台创建的账号无试用期。填 0 表示自助注册也直接永久。可在管理中心动态覆盖。
AUTH_SELF_REGISTER_TRIAL_HOURS=72

# 默认管理员。启动时若不存在会自动创建；已存在则会同步为管理员并更新密码。
# 用户名仅支持 2-32 位字母、数字、下划线、点、横线。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为至少2位的密码

# Web 跨域来源，多个用英文逗号分隔；开发可用 *
CORS_ALLOW_ORIGINS=*
